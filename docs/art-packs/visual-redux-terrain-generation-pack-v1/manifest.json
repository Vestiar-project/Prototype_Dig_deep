{
  "schemaVersion": 1,
  "packageVersion": "1.0",
  "created": "2026-08-31",
  "assetId": "depth-zero-terrain-visual-redux-v1",
  "generatorTarget": "GPT Image",
  "purpose": "Drop-in visual redux of the six-cell runtime terrain atlas with reduced microcontrast, larger geological masses, invisible logical-tile boundaries, and preserved ore contrast",
  "output": {
    "filename": "depth-zero-terrain-runtime-atlas.png",
    "format": "png",
    "colorSpace": "sRGB",
    "background": "opaque",
    "alphaAllowed": false,
    "exactWidth": 1536,
    "exactHeight": 1024,
    "columns": 3,
    "rows": 2,
    "cellWidth": 512,
    "cellHeight": 512,
    "outerPadding": 0,
    "gutter": 0,
    "fullBleedCells": true
  },
  "references": [
    {
      "label": "REFERENCE A",
      "path": "assets/field/depth-zero-terrain-runtime-atlas.png",
      "filename": "depth-zero-terrain-runtime-atlas.png",
      "required": true,
      "priority": 1,
      "role": "Authoritative current layout, terrain identities, palette, and final-seal core position",
      "doNotCopy": [
        "excessive microcontrast",
        "uniform pebble field",
        "bright edge on every fragment"
      ]
    },
    {
      "label": "REFERENCE B",
      "path": "assets/field/depth-zero-ores-runtime-atlas.png",
      "filename": "depth-zero-ores-runtime-atlas.png",
      "required": true,
      "priority": 2,
      "role": "Contrast-only reference for all ten ore nodes",
      "includeInOutput": false
    },
    {
      "label": "REFERENCE C",
      "path": "assets/field/depth-zero-vein-connectors-runtime-atlas.png",
      "filename": "depth-zero-vein-connectors-runtime-atlas.png",
      "required": true,
      "priority": 3,
      "role": "Contrast-only reference for all ten vein connector materials",
      "includeInOutput": false
    },
    {
      "label": "REFERENCE D",
      "path": "assets/field/depth-zero-field-art-master-atlas.png",
      "filename": "depth-zero-field-art-master-atlas.png",
      "required": false,
      "priority": 4,
      "role": "Style-only reference for broad hand-painted rust geo-comic massing",
      "includeInOutput": false
    }
  ],
  "layout": {
